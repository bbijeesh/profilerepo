{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Debug",
      "Yarp.ReverseProxy": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "profileServiceRoute": {
        "ClusterId": "profileServiceCluster",
        "Match": {
          "Path": "/{guild}"
        },
        "Transforms": [
          {
            "PathPattern": "/profiles/{guild}"
          }
        ]
      },
      "profileServicePostRoute": {
        "ClusterId": "profileServiceCluster",
        "Match": {
          "Path": "/profiles",
          "Methods": [
            "POST"
          ]
        },
        "Transforms": [
          {
            "PathPattern": "/profiles"
          }
        ]
      }
    },
    "Clusters": {
      "profileServiceCluster": {
        "Destinations": {
          "profileServiceDestination": {
            "Address": "http://profileserviceglobal:8080"
          }
        }
      }
    }
  }
}
